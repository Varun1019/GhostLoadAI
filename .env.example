# GhostLoad AI Environment Configuration

# Application Mode
DEMO_MODE=true

# Database (SQLite default, portable to SAP HANA Cloud)
DATABASE_URL=sqlite:///./ghostload.db

# Frontend URL (leave empty for same-origin proxy rewrites)
NEXT_PUBLIC_API_URL=

# LLM Engine Configuration (Google Gemini is default active provider)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
LLM_TIMEOUT_SECONDS=15
# Note: To change model, update GEMINI_MODEL (e.g. gemini-3-flash-preview, gemini-2.5-flash)

# SAP Generative AI Hub (Adapter ready in fallback chain, inactive unless AICORE_* vars set)
# AICORE_AUTH_URL=https://...authentication...
# AICORE_CLIENT_ID=...
# AICORE_CLIENT_SECRET=...
# AICORE_BASE_URL=https://api.ai...

# Firebase Auth (Optional - DEMO_MODE bypasses Google Auth)
# FIREBASE_PROJECT_ID=ghostload-ai
